# ==============================================================================
# FISH CATCHER BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your real '.env' file or serviceAccountKey.json to Git!
# ==============================================================================

# Server Network Configuration
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database Strategy: Google Cloud Firestore (Production Mode)
DB_DRIVER=firestore

# Firebase Admin SDK Configuration (for Firestore & Token Verification)
# Provide the path to your service account JSON file:
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# OR provide individual environment variables (for cloud hosting like Render/Railway):
FIREBASE_PROJECT_ID=fishcatcher-60484
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@fishcatcher-60484.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwgg...-----END PRIVATE KEY-----\n"

# Third-Party Interoperability: Marc Conrad's Fish Game API
# Documentation: https://marcconrad.com/uob/fish/doc.php
FISH_API_BASE=https://marcconrad.com/uob/fish/api.php

# Security & Sessions
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
