# ==============================================================================
# FISH CATCHER BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your real '.env' file or serviceAccountKey.json to Git!
# ==============================================================================

# Server Network Configuration
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database Driver Switch: 'sqlite' (local file) or 'firestore' (Firebase Cloud)
# Keep set to 'sqlite' while testing; switch to 'firestore' for production.
DB_DRIVER=sqlite

# Local SQLite Database Path (used when DB_DRIVER=sqlite)
DB_PATH=./data/fishcatcher.db

# Legacy JWT Configuration (used when DB_DRIVER=sqlite)
JWT_SECRET=change-this-to-a-secure-random-secret-in-production

# ==============================================================================
# Firebase Admin SDK Configuration (used when DB_DRIVER=firestore)
# ==============================================================================
# OPTION 1: File Path to your downloaded service account JSON key file
# (e.g., place serviceAccountKey.json in the backend root folder)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# OPTION 2: Environment variables directly (useful for cloud deployments like Render/Railway)
FIREBASE_PROJECT_ID=fishcatcher-60484
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@fishcatcher-60484.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwgg...-----END PRIVATE KEY-----\n"

# Seed administrator account for local testing
ADMIN_NAME=admin
ADMIN_EMAIL=admin@fishcatcher.local
ADMIN_PASSWORD=Admin@123
